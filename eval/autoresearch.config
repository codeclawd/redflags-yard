# Frozen runner config for the detection-quality loop.
BENCH_CMD="rm -f eval/metric.out; npx vitest run --config eval/vitest.eval.mts --reporter=dot >/dev/null 2>&1; cat eval/metric.out 2>/dev/null"
METRIC_KEY="metric"
MEM_KEY="mem_mb"
CORRECT_KEY="correct"
TIMEOUT_SEC="600"
# Guard = the project's own gate. Strengthened 2026-09-22: `pnpm test` alone let a
# type error through when a design change narrowed a Record<CategoryId,...> key set.
GUARD_CMD="pnpm tsc --noEmit && pnpm test --silent"
